{
  "name": "@reaatech/agent-auth-proxy-client",
  "version": "2.0.0",
  "description": "Typed HTTP client SDK for the agent-auth-proxy server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reaatech/agent-auth-proxy-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "agent-auth-proxy",
    "client",
    "sdk",
    "oauth2"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-auth-proxy.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/reaatech/agent-auth-proxy/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/reaatech/agent-auth-proxy/issues"
  }
}
