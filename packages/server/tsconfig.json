{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@auth/*": ["src/auth/*"],
      "@config/*": ["src/config/*"],
      "@db/*": ["src/db/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      "@proxy/*": ["src/proxy/*"]
    }
  },
  "include": ["src/**/*"]
}
