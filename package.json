{
  "name": "agent-auth-proxy",
  "version": "1.0.0",
  "description": "Identity-aware proxy for agent-to-service communication",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsup src/app.ts --format esm --dts",
    "start": "node dist/app.js",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/security",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' --ext .ts",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts' --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "docker:build": "docker build -t agent-auth-proxy .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "audit": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pino": "^8.17.0",
    "postgres": "^3.4.3",
    "prom-client": "^15.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "tsup": "^8.0.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "proxy",
    "auth",
    "oauth2",
    "api",
    "agent",
    "identity",
    "security"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/agent-auth-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/agent-auth-proxy/issues"
  },
  "homepage": "https://github.com/reaatech/agent-auth-proxy#readme",
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.2",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0"
    }
  }
}
