# Node environment
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agent_auth

# Encryption
# MASTER_KEY must be a base64-encoded 32-byte key (44 characters minimum)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=YUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=

# Agent JWT
# AGENT_JWT_SECRET should be a strong random string (32+ chars recommended)
AGENT_JWT_SECRET=change-me-in-production
AGENT_JWT_EXPIRY=3600

# Admin API Key for management endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=change-me-in-production

# OAuth
OAUTH_REDIRECT_URI=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Audit & SIEM
AUDIT_RETENTION_DAYS=90
# SIEM_ENDPOINT=
# SIEM_API_KEY=

# Rate Limits
RATE_LIMIT_GLOBAL_MAX=1000

# Proxy Settings
PROXY_STREAM_TIMEOUT_MS=60000
PROXY_BODY_LIMIT_BYTES=10485760
PROXY_STREAM_THRESHOLD_BYTES=1048576

# Audit
# AUDIT_BATCH_SIZE=100
# AUDIT_FLUSH_INTERVAL_MS=5000
